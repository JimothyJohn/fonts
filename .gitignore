.venv/
__pycache__/
*.pyc
# out/ is scratch (jitter variants, versioned snapshots, demo copies),
# but the finished fonts and their specimen sheets ARE the product and
# stay tracked. Builds are deterministic, so tracked artifacts only
# change when the source does.
out/*
!out/aperture-*.ttf
!out/alphabet-*.png
!out/specimen-*.png
.DS_Store
